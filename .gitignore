.venv/
__pycache__/
*.pyc
.env
node_modules/
rideshare.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*
infra/terraform.tfvars
infra/.build/

# Android app (mobile/android/): signing keys must never be committed,
# nor build outputs.
*.keystore
*.jks
*.p12
*.pem
keystore.properties
*.apk
*.aab
*.idsig
mobile/android/**/build/
mobile/android/.gradle/
mobile/android/local.properties
signing-key-info.txt

# Routing data build (routing/build.sh)
routing/.work/
loadtest/.work/

# iOS app (mobile/ios/): the Xcode project is generated from project.yml,
# and signing files must never be committed.
mobile/ios/*.xcodeproj/
mobile/ios/build/
*.xcarchive
*.ipa
*.mobileprovision
*.p8

# Copy to terraform.tfvars (gitignored) and adjust.

# Leave unset to serve plain HTTP on the server's IP. Set it to your domain to
# create its Route 53 zone and records, then set the name_servers output as the
# domain's nameservers at the registrar. Update the GitHub SITE_ADDRESS variable
# from the github_actions_variables output and redeploy: Caddy then obtains
# Let's Encrypt certificates and redirects HTTP to HTTPS.
# domain_name = "rideandrail.ch"

# Email address for site-down alerts; leave unset for no monitoring. AWS sends
# a confirmation link to it first, which must be clicked.
# alert_email = "you@example.ch"

# aws_region    = "eu-north-1"
# instance_type = "t4g.micro"
